{
  "name": "@quietgridlabs/viaduct",
  "private": true,
  "author": "Quiet Grid Labs",
  "version": "0.1.0",
  "type": "module",
  "license": "BUSL-1.1",
  "scripts": {
    "dev": "node scripts/vendorRedoc.mjs && vite --host",
    "build": "node scripts/vendorRedoc.mjs && tsc -b && vite build && node scripts/prerender.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "type-check": "tsc -b",
    "preview": "vite preview",
    "cypress": "start-server-and-test dev http://localhost:5173 'cypress open'",
    "test": "start-server-and-test dev http://localhost:5173 'cypress run'",
    "test:node": "jest --config jest.config.js",
    "test:ci": "cypress run",
    "prerender": "node scripts/prerender.mjs",
    "vendor:redoc": "node scripts/vendorRedoc.mjs",
    "prepare": "husky",
    "commitlint": "commitlint --edit"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --max-warnings=0"
  },
  "dependencies": {
    "@archivisio/c4-modelizer-sdk": "1.0.0",
    "@chakra-ui/react": "^3.36.1",
    "@emotion/react": "^11.14.0",
    "@monaco-editor/react": "^4.7.0",
    "@ridemountainpig/svgl-react": "^1.0.17",
    "@tanstack/react-query": "^5.79.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@xyflow/react": "^12.6.0",
    "devicons-react": "^1.4.1",
    "fflate": "^0.8.2",
    "i18next": "^25.0.1",
    "lucide-react": "^1.29.0",
    "monaco-editor": "^0.56.0",
    "prismjs": "^1.30.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.5.1",
    "react-router-dom": "^7.18.2",
    "react-syntax-highlighter": "^15.6.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@4tw/cypress-drag-drop": "^2.3.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.22.0",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "cypress": "^14.3.2",
    "cypress-file-upload": "^5.0.8",
    "cypress-vite": "^1.6.0",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jest-transform-stub": "^2.0.0",
    "lint-staged": "^17.5.0",
    "redoc": "^2.5.3",
    "start-server-and-test": "^2.0.11",
    "ts-jest": "^29.3.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.3.4"
  },
  "overrides": {
    "test-exclude": "^8.0.0"
  }
